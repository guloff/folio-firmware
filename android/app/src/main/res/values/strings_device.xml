    <string name="device_forget">Forget reader</string>
    <string name="device_forget_title">Forget the reader?</string>
    <string name="device_forget_message">The phone deletes the pairing key and the reader’s address. Cached stats stay. To change data again, connect and enter a PIN.</string>
