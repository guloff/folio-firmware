<resources>
    <!-- Окно подключения -->
    <string name="device_connect_title">Connect to Folio</string>
    <string name="device_found_header">Discovered devices</string>
    <string name="device_found_footer">1. On the reader: Menu → “Phone sync”.\n2. Phone and reader on the same Wi‑Fi network.\n3. The reader appears in the list above.</string>
    <string name="device_found_need_access">Allow access to devices on your local network to search for the reader.</string>
    <string name="device_searching">Searching for readers…</string>
    <string name="device_nothing_found">Nothing found</string>
    <string name="device_search_again">Search again</string>
    <string name="device_manual_header">Manual</string>
    <string name="device_manual_hint">IP address, folio.local or host:port</string>
    <string name="device_manual_footer">The IP address is shown on the reader’s “Phone sync” screen (for example, 192.168.1.42). You can also enter folio.local.</string>
    <string name="device_manual_footer_debug">Emulator: the mock on the Mac is 10.0.2.2:8080.</string>
    <string name="device_connect_button">Connect</string>
    <string name="device_demo_button">Try without a reader</string>
    <string name="device_demo_footer">Demo mode: a virtual reader with sample books, stats and highlights. Changes are not kept. To leave it, connect your own reader.</string>
    <string name="device_last_device">Last device</string>
    <string name="device_disconnect">Disconnect</string>
    <string name="device_lan_header">Local network</string>
    <string name="device_lan_explain">FolioLink talks to the reader over your Wi‑Fi network. To find and connect to it, allow access to devices on the local network. The app only connects to your reader.</string>
    <string name="device_lan_allow">Allow access</string>
    <string name="device_lan_denied">Access to the local network is denied. Turn on “Nearby devices on local network” for FolioLink in the app settings. Demo mode works without it.</string>
    <string name="device_open_app_settings">Open app settings</string>

    <!-- Сопряжение -->
    <string name="device_pair_title">Pair with reader</string>
    <string name="device_pair_later">Later</string>
    <string name="device_pin_header">PIN from the reader’s screen</string>
    <string name="device_pin_valid_for">PIN valid for another %1$d s</string>
    <string name="device_pin_expired_request">PIN expired — request a new one</string>
    <string name="device_pin_requesting">Requesting a PIN…</string>
    <string name="device_pin_checking">Checking…</string>
    <string name="device_pin_shown">The reader shows a PIN</string>
    <string name="device_pin_explain">Enter the 6 digits shown on the reader. This is how the reader recognizes your phone: without pairing the app can only read data, not change it.</string>
    <string name="device_pin_new">Show a new PIN</string>
    <string name="device_pin_new_in">New PIN in %1$d s</string>
    <string name="device_pin_footer">A PIN lives 2 minutes. After 5 wrong tries a new one is needed.</string>

    <!-- Экран «Устройство» -->
    <string name="device_title">Device</string>
    <string name="device_pairing_header">Pairing</string>
    <string name="device_pairing_footer">The reader accepts changes (statuses, shelves, files, settings) only from paired phones. Pairing can be fully reset in the reader’s menu.</string>
    <string name="device_paired">Paired with this phone</string>
    <string name="device_unpaired">Not paired: the reader won’t accept changes</string>
