    <!-- Bluetooth -->
    <string name="device_ble_header">Bluetooth</string>
    <string name="device_ble_toggle">Bluetooth sync</string>
    <string name="device_ble_footer">No Wi‑Fi needed: stats, sessions, highlights, vocabulary and the book list arrive by themselves whenever the reader wakes up. Files and screenshots still need Wi‑Fi. On the reader turn on “Bluetooth sync” (Settings → System): it takes effect after the reader restarts. The reader must already be paired with this phone over Wi‑Fi.</string>
