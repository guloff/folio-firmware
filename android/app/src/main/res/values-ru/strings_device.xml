<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Окно подключения -->
    <string name="device_connect_title">Подключение к Folio</string>
    <string name="device_found_header">Найденные устройства</string>
    <string name="device_found_footer">1. На читалке: Меню → «Связь с телефоном».\n2. Телефон и читалка — в одной Wi‑Fi сети.\n3. Читалка появится в списке выше.</string>
    <string name="device_found_need_access">Чтобы искать читалку, разрешите доступ к устройствам в локальной сети.</string>
    <string name="device_searching">Поиск читалок в сети…</string>
    <string name="device_nothing_found">Ничего не найдено</string>
    <string name="device_search_again">Искать снова</string>
    <string name="device_manual_header">Вручную</string>
    <string name="device_manual_hint">IP-адрес, folio.local или host:port</string>
    <string name="device_manual_footer">IP-адрес показан на экране «Связь с телефоном» на читалке (например, 192.168.1.42). Можно ввести и имя folio.local.</string>
    <string name="device_manual_footer_debug">Эмулятор: мок-сервер на Mac — 10.0.2.2:8080.</string>
    <string name="device_connect_button">Подключиться</string>
    <string name="device_demo_button">Попробовать без читалки</string>
    <string name="device_demo_footer">Демо-режим: виртуальная читалка с примерами книг, статистики и выделений. Изменения в нём не сохраняются. Чтобы выйти, подключите свою читалку.</string>
    <string name="device_last_device">Последнее устройство</string>
    <string name="device_disconnect">Отключиться</string>
    <string name="device_lan_header">Локальная сеть</string>
    <string name="device_lan_explain">FolioLink общается с читалкой через вашу Wi‑Fi сеть. Чтобы найти её и подключиться, разрешите доступ к устройствам в локальной сети. Приложение подключается только к вашей читалке.</string>
    <string name="device_lan_allow">Разрешить доступ</string>
    <string name="device_lan_denied">Доступ к локальной сети запрещён. Включите для FolioLink «Устройства поблизости в локальной сети» в настройках приложения. Демо-режим работает и без него.</string>
    <string name="device_open_app_settings">Открыть настройки приложения</string>

    <!-- Сопряжение -->
    <string name="device_pair_title">Сопряжение с читалкой</string>
    <string name="device_pair_later">Позже</string>
    <string name="device_pin_header">PIN с экрана читалки</string>
    <string name="device_pin_valid_for">PIN действует ещё %1$d с</string>
    <string name="device_pin_expired_request">PIN истёк — запросите новый</string>
    <string name="device_pin_requesting">Запрашиваем PIN…</string>
    <string name="device_pin_checking">Проверяем…</string>
    <string name="device_pin_shown">Читалка показывает PIN</string>
    <string name="device_pin_explain">Введите 6 цифр с экрана читалки. Так читалка узнаёт ваш телефон: без сопряжения приложение может только читать данные, но не менять их.</string>
    <string name="device_pin_new">Показать новый PIN</string>
    <string name="device_pin_new_in">Новый PIN через %1$d с</string>
    <string name="device_pin_footer">PIN живёт 2 минуты. После 5 неверных попыток нужен новый.</string>

    <!-- Экран «Устройство» -->
    <string name="device_title">Устройство</string>
    <string name="device_pairing_header">Сопряжение</string>
    <string name="device_pairing_footer">Изменения (статусы, полки, файлы, настройки) читалка принимает только от сопряжённых телефонов. Полностью сбросить сопряжение можно в меню читалки.</string>
    <string name="device_paired">Сопряжено с этим телефоном</string>
    <string name="device_unpaired">Не сопряжено: читалка не примет изменения</string>
